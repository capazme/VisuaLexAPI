# Python API configuration. Every variable here is optional — the defaults are
# the development ones, which is exactly why ALLOWED_ORIGINS bites in
# production: leave it unset and CORS accepts localhost only.
# Copy to .env and adjust. See docs/deployment.md.

# Server
HOST="0.0.0.0"
PORT=5000

# CORS — comma-separated. MUST list the production origin.
# Default (unset): http://localhost:3001,http://localhost:5173
# ALLOWED_ORIGINS="https://your-domain.example"

# Rate limiting (per IP, root app.py middleware)
RATE_LIMIT=1000
RATE_LIMIT_WINDOW=600
# How many reverse proxies sit in front of this service (the container ingress is
# one). 0 = X-Forwarded-For is not believed at all, which is right for a service
# reached directly. Behind a proxy set the real number, or every client shares ONE
# rate-limit bucket (the proxy's address).
TRUSTED_PROXIES=0

# Log file. Unset keeps today's files (norma.log, visualex_api.log) in the working
# directory; set it EMPTY for console only — a container with a read-only root
# cannot open a file, and used to fail at import.
# VISUALEX_LOG_FILE=

# Redis. With REDIS_ENABLED=false the cache falls back to the filesystem
# (per-instance) and a warning is logged at startup.
REDIS_ENABLED="false"
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_PREFIX="vlx"
PERSISTENT_CACHE_TTL=86400

# Scraper HTTP client tuning — see visualex_api/tools/config.py for defaults
# HTTP_MAX_CONCURRENCY=
# HTTP_TIMEOUT=
# HTTP_MAX_RETRIES=
# HTTP_BACKOFF_FACTOR=
# HTTP_INITIAL_BACKOFF=
# HTTP_MIN_INTERVAL=
# HTTP_JITTER=

# Parallel fetch queue
# FETCH_QUEUE_WORKERS=
# FETCH_QUEUE_DELAY=

# Akoma Ntoso export. Structure source and last-resort text fallback only — the
# reading text always comes from the HTML path. Set false to switch it all off.
AKN_ENABLED="true"
# How many act indexes are held in memory (a few tens of KB each).
AKN_CACHE_MAX_ACTS=40
