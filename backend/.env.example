# Database (REQUIRED)
DATABASE_URL="postgresql://user:password@localhost:5432/visualex_platform"

# JWT (REQUIRED - generate with: openssl rand -base64 32)
JWT_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
JWT_ACCESS_EXPIRY="30m"
JWT_REFRESH_EXPIRY="7d"

# Server
PORT=3001
NODE_ENV="development"

# CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3001"
# To expose the app over an ngrok tunnel, append your tunnel host, e.g.:
# ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3001,https://<your-id>.ngrok-free.app"

# Redis (recommended - enables shared rate limiting & cache)
# If disabled, rate limiter falls back to in-memory (per-instance, lost on restart)
# and the Python API cache uses the filesystem backend. A warning is logged at startup.
REDIS_URL="redis://localhost:6379/0"
REDIS_ENABLED="true"

# MERLT / RLCF sidecar
# Node proxies authenticated VisuaLex requests from /api/merlt/* to this service.
# MERLT_ENABLED is the single master switch (app.ts merltKillSwitch): "false"
# 404s the whole /api/merlt namespace. It is off here because vanilla dev has
# no sidecar; `MERLT_ENABLED=true ./start.sh` wins over this file, since dotenv
# never overwrites a variable already in the environment.
MERLT_ENABLED="false"
MERLT_API_URL="http://localhost:8000"
# MERL-T API key, sent as the X-API-Key header by every BFF client (NOT
# 'Authorization: Bearer' — MERL-T's verify_api_key only reads X-API-Key). It is
# REQUIRED only by the MERL-T routes behind require_role('admin'): RLCF
# training and graph hygiene (opsClient), mechanical ingestion, NER training.
# User endpoints (Q&A, feedback, graph, contributions) accept keyless requests
# because merlt/app.py makes verify_api_key optional. Mint one with
# POST :8000/api/v1/api-keys/bootstrap, or let MERLT_ADMIN_API_KEY seed it.
MERLT_API_KEY=""
MERLT_TIMEOUT_MS="60000"
# Sub-feature gates (each defaults to true/enabled when unset). They exist to
# switch ONE feature off in production, not to quiet local dev: with
# contribution off the worker's /internal/extraction-callback 404s, with graph
# off /internal/job-callback does, and ops off hides the admin routes only
# (POST /ner/feedback rides the contribution flag).
# contribution → /contrib/* + POST /ner/feedback, validation → /validate/*,
# graph → /graph/*, ops → /ops/* + /ner/training/* + /ner/feedback/stats.
MERLT_CONTRIBUTION_ENABLED="true"
MERLT_VALIDATION_ENABLED="true"
MERLT_GRAPH_ENABLED="true"
MERLT_OPS_ENABLED="true"
# Shared secret for every MERL-T → BFF callback (worker job/extraction
# callbacks, api Q&A progress callback; header X-Internal-Secret). It MUST be
# the same value docker-compose.merlt.yml interpolates for merlt-api and
# merlt-worker: the compose default is "dev-internal-secret", so this file
# ships the same one. An empty value makes the BFF answer 500 to every
# callback and jobs sit "in corso" until the watchdog. Override BOTH in
# production (root .env, see .env.merlt.example).
MERLT_INTERNAL_SECRET="dev-internal-secret"
# Subgraph cache on GET /api/merlt/graph/article/:urn (in-memory, single-instance).
# TTL clamped to [60000, 300000] ms; entries bound is LRU-evicted.
MERLT_SUBGRAPH_CACHE_TTL_MS="120000"
MERLT_SUBGRAPH_CACHE_MAX_ENTRIES="200"
# TTL (ms) after which a pending/running ingestion job with no worker callback
# is considered dead: ensureIngestionJob flips it to 'timeout' and re-enqueues
# instead of blocking re-ingestion of the URN forever. Default 600000 (10 min).
MERLT_INGEST_STALE_MS="600000"
# TTL (ms) for note-extraction jobs (MerltExtractionJob) with no worker
# callback. Must stay ABOVE MERLT_EXTRACT_JOB_TIMEOUT (RQ, 1800 s in
# docker-compose.merlt.yml) plus queue wait and the 5-min sweep, or a slow but
# healthy extraction is flipped to 'timeout' before its callback lands.
# Default 2700000 (45 min).
MERLT_EXTRACT_STALE_MS="2700000"
# TTL (ms) after which a pending/running async Q&A job (qa-async-progressive-
# contract.md) with no fresh callback is considered dead: the watchdog sweeps
# it against `updatedAt` (last per-expert callback), not `createdAt` — a
# heavy ReAct deliberation legitimately runs up to ~11min. Default 1200000
# (20 min).
MERLT_QA_STALE_MS="1200000"
# Retention (days) for TERMINAL (completed/failed/timeout) MerltQaJob rows —
# `result` can carry tens/hundreds of KB of pipeline_trace per query. Swept
# by the same watchdog interval. Default 30.
MERLT_QA_RETENTION_DAYS="30"

# MERLT startup (used by start.sh)
# MERLT_COMPOSE_ENABLED: true → start docker compose (postgres/redis/falkordb/qdrant)
# MERLT_API_IN_DOCKER:   true (default) → MERL-T api + worker + mcp-legal-it run as
#                        containers (profile 'api-in-docker'); this is the
#                        supported path and implies MERLT_COMPOSE_ENABLED=true.
#                        false → developer-only: uvicorn + rq worker from
#                        MERLT_PYTHON (a venv with the merlt deps), deps still
#                        in Docker, no mcp-legal-it tools.
# First run builds the image (~5 min, ~600 MB) and needs the vendor/mcp-legal-it
# submodule (start.sh initialises it).
MERLT_COMPOSE_ENABLED="false"
MERLT_API_IN_DOCKER="true"
MERLT_HEALTH_TIMEOUT="60"

# Admin Seed (optional - for initial admin user creation)
# ADMIN_EMAIL="admin@example.com"
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="use_a_strong_password_here"
