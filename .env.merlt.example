# =============================================================================
# MERL-T Docker stack — environment template
# =============================================================================
# Variables consumed by docker-compose.merlt.yml. Docker Compose auto-loads a
# file named `.env` in the project root, so on the server:
#
#   cp .env.merlt.example .env        # then edit the values below
#   ./deploy.sh --merlt
#
# (If a root `.env` already exists for other purposes, append these keys to it.)
#
# Every value here has a built-in default in the compose file; you ONLY need to
# override the SECRETS and the OpenRouter key for a real deployment. Ports are
# bound to 127.0.0.1 by the compose file (not publicly exposed) — change them
# only on a port clash.
# -----------------------------------------------------------------------------

# --- Secrets (CHANGE THESE — do not ship the dev defaults to prod) -----------

# MERL-T Postgres password. Default is the throwaway "merlt"; use a strong value.
MERLT_POSTGRES_PASSWORD="change-me-strong-db-password"

# Shared secret for worker -> BFF internal callbacks (job status / extraction).
# MUST be identical to MERLT_INTERNAL_SECRET in backend/.env, or callbacks 401.
MERLT_INTERNAL_SECRET="change-me-long-random-secret"

# OpenRouter API key — REQUIRED for Slice 2c (document extraction runs on the
# worker). Leave empty only if you will not use "apprendi dai miei appunti".
OPENROUTER_API_KEY=""

# --- Postgres identity (defaults are fine; password above is the one that matters)
MERLT_POSTGRES_USER="merlt"
MERLT_POSTGRES_DB="merlt"

# --- Host port mappings (all bound to 127.0.0.1 in compose) ------------------
MERLT_POSTGRES_PORT="5436"
MERLT_REDIS_PORT="6381"
MERLT_FALKOR_PORT="6382"
MERLT_QDRANT_PORT="6343"
MERLT_QDRANT_GRPC_PORT="6344"
MERLT_API_PORT="8000"
MCP_LEGAL_IT_PORT="8011"

# --- Graph + seed/embeddings tuning ------------------------------------------
# FalkorDB graph name (keep in sync with the seed loader / BFF).
MERLT_GRAPH_NAME="merl_t_legal"

# Let the api seed the Libro IV graph at boot (idempotent: skips if >100 nodes).
MERLT_SKIP_SEED="false"

# Skip the slow CPU embedding step at seed time. KEEP "true" on a CPU-only
# server: e5-large is ~2s/text on docker CPU, so the full set takes hours.
# Generate embeddings separately if/when needed (see docs/legacy-libro-iv-seed.md).
MERLT_SKIP_EMBEDDINGS="true"

# --- BFF callback URLs (defaults work now that extra_hosts maps host-gateway)
# Override only if the BFF runs somewhere other than the host on :3001.
# MERLT_BFF_CALLBACK_URL="http://host.docker.internal:3001/api/merlt/internal/job-callback"
# MERLT_BFF_EXTRACTION_CALLBACK_URL="http://host.docker.internal:3001/api/merlt/internal/extraction-callback"

# =============================================================================
# Reminder — matching keys live in backend/.env (NOT here). On the server set:
#   MERLT_ENABLED="true"
#   MERLT_API_URL="http://localhost:8000"
#   MERLT_INTERNAL_SECRET=<same value as above>
#   MERLT_API_KEY=<only needed for admin/ops routes>
#   MERLT_CONTRIBUTION_ENABLED / MERLT_VALIDATION_ENABLED / MERLT_OPS_ENABLED /
#   MERLT_GRAPH_ENABLED  — toggle features as desired
# =============================================================================
