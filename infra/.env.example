# Variables for infra/compose.yml. Copy to infra/.env (never committed).
# A throwaway stack (tests, onboarding checks) sets its own name AND ports.
VISUALEX_STACK=visualex
VISUALEX_PG_PORT=5436
VISUALEX_REDIS_PORT=6381
VISUALEX_FALKOR_PORT=6382
VISUALEX_QDRANT_PORT=6343
VISUALEX_QDRANT_GRPC_PORT=6344
MCP_LEGAL_IT_PORT=8011
MERLT_API_PORT=8000

# Development passwords only. In production ./start.sh --prod generates all three, and
# infra/compose.prod.yml refuses to start without them: it never falls back to these.
POSTGRES_PASSWORD=postgres
PLATFORM_DB_PASSWORD=visualex
MERLT_DB_PASSWORD=merlt

# MERL-T. Each developer uses their own model key; empty = no LLM calls.
OPENROUTER_API_KEY=
MERLT_GRAPH_NAME=merl_t_legal
MERLT_QDRANT_COLLECTION=merl_t_legal_chunks

# --- Production: ./start.sh --prod (infra/compose.app.yml, compose.scrapers.yml, compose.prod.yml) ---
# Needs Docker Compose 2.24 or newer.

# The one door. Bind it to the machine's home-network address to reach it from other
# devices; the default keeps it on the machine itself. Nothing else is published beyond
# the loopback.
INGRESS_BIND=127.0.0.1
INGRESS_PORT=8080
# The browser's address of the app: the server's CORS allow-list. Comma-separated. Keep it
# in step with INGRESS_BIND / INGRESS_PORT: the address people actually type.
PUBLIC_ORIGIN=http://localhost:8080

# A fixed subnet for the request-path network: the host firewall rule that keeps the
# scrapers away from the home network is keyed on it. Change it if it collides with yours.
APP_SUBNET=172.29.240.0/24
# The ingress's own network. Fixed, because the ingress keeps a forwarded client address
# (X-Forwarded-For) only from this subnet and APP_SUBNET. Change it if it collides with yours.
EDGE_SUBNET=172.29.241.0/24

# The scrapers' address as the server, MERL-T and the ingress see it: host:port, NOT a URL
# (the files add http:// where they need it). Change it only to run that module on another
# machine (compose.scrapers.yml on its own).
SCRAPERS_ADDR=scrapers:5000
# Memory ceiling of the scrapers (Chromium). Measured: about 280 MiB idle, about 1.06 GiB
# with four PDF exports at once.
SCRAPERS_MEM_LIMIT=2g

# MERL-T on the server's side. ./start.sh --prod generates the two secrets below on the
# first run; they are shared by the server and MERL-T and live here and nowhere else.
# MERLT_ENABLED=true
# MERLT_INTERNAL_SECRET=
# MERLT_API_KEY=

# Optional: every store in one directory (with infra/compose.datadir.yml).
# VISUALEX_DATA_DIR=/path/to/visualex-data
