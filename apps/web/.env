# API Base URL
# Relative path so calls go to the page origin and Vite proxies them to the
# Node backend (:3001) / Python API (:5000). This works both locally AND over
# an ngrok tunnel shared with others (an absolute http://localhost URL would
# hit the visitor's own machine and be blocked as mixed content over https).
VITE_API_URL=/api

# Production: Point to your deployed backend
# VITE_API_URL=https://api.visualex.com/api
