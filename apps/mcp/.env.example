# VisuaLex's MCP server (apps/mcp). Copy to .env for `npm run dev`; the defaults
# fit the development stack.

# Where it listens. Keep 127.0.0.1 in development: the server also refuses
# Host headers that are not loopback (DNS rebinding).
# MCP_HOST=127.0.0.1
# MCP_PORT=3002

# The endpoint's canonical URL, exactly as users type it in their client
# (`claude mcp add --transport http visualex http://localhost:3002/mcp`). It is
# the audience of the access tokens: apps/server's OAUTH_MCP_RESOURCE must be
# the same string.
# MCP_RESOURCE=http://localhost:3002/mcp

# The authorization server (apps/server) and the API it serves.
# MCP_AUTH_ISSUER=http://localhost:3001
# MCP_API_BASE=http://localhost:3001/api

# Required. The MCP server's credential at the authorization server: the same
# value as apps/server's OAUTH_MCP_CLIENT_SECRET (`openssl rand -base64 32`).
MCP_CLIENT_SECRET=

# Browser origins allowed to call the endpoint (comma-separated). Native clients
# such as Claude Code send no Origin header and need nothing here.
# MCP_ALLOWED_ORIGINS=
