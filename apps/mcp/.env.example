# VisuaLex's MCP server (apps/mcp). Copy to .env for `npm run dev`; the defaults
# fit the development stack.

# Where it listens. Keep 127.0.0.1 in development. On any bind it refuses a Host
# other than MCP_RESOURCE's hostname or the loopback names (DNS rebinding).
# MCP_HOST=127.0.0.1
# MCP_PORT=3002

# The endpoint's canonical URL, exactly as users type it in their client
# (`claude mcp add --transport http visualex http://localhost:3002/mcp`). It is
# the audience of the access tokens: apps/server's OAUTH_MCP_RESOURCE must be
# the same string.
# MCP_RESOURCE=http://localhost:3002/mcp

# The authorization server (apps/server) and the API it serves.
# MCP_AUTH_ISSUER=http://localhost:3001
# MCP_API_BASE=http://localhost:3001/api
# Where it calls the authorization server (introspection, token exchange). Defaults to
# MCP_AUTH_ISSUER; in the production stack it is the server's container address, because
# the issuer is the public origin, which a container cannot reach.
# MCP_AUTH_URL=http://localhost:3001
# The audience asked for in the token exchange; defaults to MCP_API_BASE and must equal
# apps/server's OAUTH_API_AUDIENCE (default OAUTH_ISSUER/api). `localhost` and
# `127.0.0.1` are different strings: a mismatch makes every tool fail.
# MCP_API_AUDIENCE=http://localhost:3001/api

# Required. The MCP server's credential at the authorization server: the same
# value as apps/server's OAUTH_MCP_CLIENT_SECRET (`openssl rand -base64 32`).
MCP_CLIENT_SECRET=

# Browser origins not refused outright (comma-separated). Native clients such as
# Claude Code send no Origin header and need nothing here. The server sends no CORS
# headers yet, so a browser page cannot use the endpoint even when listed: a page
# client (a web LibreLex) is a later round.
# MCP_ALLOWED_ORIGINS=
# How long a deletion waits for the user to answer the confirmation dialog (ms; default 300000 = 5 minutes).
# MCP_CONFIRMATION_TIMEOUT_MS=300000
